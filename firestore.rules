rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Per-user data. Users may only ever touch their own subtree.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Voice profiles. The client creates/renames/deletes the doc; the
      // elevenLabsVoiceId + status are written by Cloud Functions (the Admin
      // SDK bypasses these rules).
      match /voices/{voiceId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // AI-generated stories owned by the user.
      match /generatedStories/{storyId} {
        allow read, write: if isOwner(uid);
      }

      // Cached narration metadata is written by Cloud Functions only.
      match /narrations/{narrationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Archived (saved) community stories — client-managed bookmarks.
      match /archived/{publishedStoryId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Curated story library: world-readable, admin/Cloud-Function writable only.
    match /stories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    // Community-published stories. Readable by any signed-in user; all writes
    // (the story, likes, comments) go through moderated Cloud Functions only.
    match /publishedStories/{storyId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /likes/{uid} {
        allow read: if isOwner(uid);    // "did I like this?"
        allow write: if false;           // toggleLike Cloud Function only
      }
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow write: if false;           // addComment Cloud Function only (moderated)
      }
      match /reports/{reportId} {
        allow create: if isSignedIn();   // users may flag content
        allow read, update, delete: if false;
      }
    }
  }
}
