rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Raw voice samples (input to cloning). Owner uploads/reads; capped size,
    // audio only.
    match /users/{uid}/voiceSamples/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Synthesized narration audio: written by Cloud Functions; owner reads.
    match /users/{uid}/narrations/{fileName} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Library cover art: public read, admin/Cloud-Function write only.
    match /stories/{storyId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Shared, non-sensitive fixture audio used by integration tests, so it
    // doesn't need to ship inside every app install. Any signed-in user may
    // read; uploaded out-of-band, never by the client.
    match /test_fixtures/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
